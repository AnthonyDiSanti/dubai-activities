{
  "name": "dubai-activities",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run generate:attributions",
    "dev": "vite",
    "prebuild": "npm run generate:attributions",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "audit:content": "tsx scripts/audit-activity-content.ts",
    "audit:attributions": "python3 scripts/photo-attributions.py audit",
    "audit:site": "tsx scripts/audit-site-structure.ts",
    "audit:photos": "python3 scripts/audit-photo-manifest.py && python3 scripts/check-photo-similarity.py",
    "generate:attributions": "python3 scripts/photo-attributions.py generate",
    "sync:attributions": "python3 scripts/photo-attributions.py sync",
    "check": "npm run lint && npm run test && npm run build && npm run audit:content && npm run audit:site"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
